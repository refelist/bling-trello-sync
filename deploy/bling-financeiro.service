[Unit]
Description=Coleta financeira Bling → Postgres (JH) — oneshot sem Trello
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/bling-trello-sync
EnvironmentFile=/opt/bling-trello-sync/.env
# Não sobe FastAPI/webhook; só a frente financeira.
ExecStart=/opt/bling-trello-sync/.venv/bin/python -m bling_trello_sync.cli sincronizar-financeiro
Nice=10
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
