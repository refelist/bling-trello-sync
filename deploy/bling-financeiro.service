[Unit]
Description=Coleta financeira Bling → Postgres (JH), separada dos apps do Trello
After=network-online.target postgresql.service
Wants=network-online.target

# Instalado por deploy/instalar-financeiro.sh. Usa app Bling, token e .env próprios
# em /root/bling-financeiro: um problema aqui não derruba o Trello, e vice-versa.
[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bling-financeiro
ExecStart=/root/bling-financeiro/.venv/bin/python -m bling_trello_sync.cli sincronizar-financeiro
Nice=10
CPUWeight=20
MemoryMax=450M
TimeoutStartSec=50min
