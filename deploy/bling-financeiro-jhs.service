[Unit]
Description=Coleta financeira Bling → Postgres (JHS) — oneshot sem Trello
After=network-online.target postgresql.service
Wants=network-online.target

# Só use se NÃO houver uvicorn com FINANCEIRO_ATIVO=true (evita coleta duplicada).
# Ajuste paths para a pasta real (ex.: /root/bling-trello-sync-2).
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/bling-trello-sync-jhs
EnvironmentFile=/opt/bling-trello-sync-jhs/.env
ExecStart=/opt/bling-trello-sync-jhs/.venv/bin/python -m bling_trello_sync.cli sincronizar-financeiro
Nice=10
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
