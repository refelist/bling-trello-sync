            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT data::timestamp AS time, SUM(SUM(valor)) OVER (ORDER BY data) AS \"Saldo\" FROM vw_fluxo_caixa WHERE empresa IN ($empresa) AND $__timeFilter(data) GROUP BY data ORDER BY 1"
