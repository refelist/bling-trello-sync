          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('month', data)::timestamp AS time, empresa AS metric, SUM(total) AS value FROM vw_faturamento WHERE empresa IN ($empresa) AND $__timeFilter(data) GROUP BY 1, 2 ORDER BY 1"
