    {
      "type": "stat",
      "title": "Faturamento",
      "description": "Pedidos de venda no período (exclui cancelados). Compara com o período imediatamente anterior de mesma duração.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (SELECT COALESCE(SUM(total), 0) FROM vw_faturamento WHERE empresa IN ($empresa) AND data >= to_timestamp($__from / 1000.0) AND data < to_timestamp($__to / 1000.0)), anterior AS (SELECT COALESCE(SUM(total), 0) FROM vw_faturamento WHERE empresa IN ($empresa) AND data >= to_timestamp($__from / 1000.0) - (to_timestamp($__to / 1000.0) - to_timestamp($__from / 1000.0)) AND data < to_timestamp($__from / 1000.0)) SELECT (SELECT * FROM atual) AS \"Valor\", CASE WHEN (SELECT * FROM anterior) = 0 THEN NULL ELSE ((SELECT * FROM atual) - (SELECT * FROM anterior)) / ABS((SELECT * FROM anterior)) END AS \"vs período anterior\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#1F4E79"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs período anterior"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#C62828",
                      "value": null
                    },
                    {
                      "color": "#2E7D32",
                      "value": 0
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
