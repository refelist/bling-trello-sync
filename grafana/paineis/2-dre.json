    {
      "type": "table",
      "title": "Resultado por empresa",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT empresa AS \"Empresa\", SUM(valor) FILTER (WHERE natureza = 'receita') AS \"Receita\", -SUM(valor) FILTER (WHERE natureza = 'despesa') AS \"Despesas\", SUM(valor) AS \"Resultado\", SUM(valor) / NULLIF(SUM(valor) FILTER (WHERE natureza = 'receita'), 0) AS \"Margem\" FROM vw_dre WHERE empresa IN ($empresa) AND $__timeFilter(competencia) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 2,
          "custom": {
            "align": "auto",
            "minWidth": 90
