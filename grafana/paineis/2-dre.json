    {
      "type": "timeseries",
      "title": "Resultado por mês",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT date_trunc('month', competencia)::timestamp AS time, 'Resultado' AS metric, SUM(valor) AS value FROM vw_dre WHERE empresa IN ($empresa) AND $__timeFilter(competencia) GROUP BY 1, 2 ORDER BY 1"
        }
