    {
      "type": "table",
      "title": "DRE por categoria",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE WHEN natureza = 'receita' THEN 'Receita' ELSE 'Despesa' END AS \"Natureza\", categoria AS \"Categoria\", SUM(ABS(valor)) AS \"Valor\" FROM vw_dre WHERE empresa IN ($empresa) AND $__timeFilter(competencia) GROUP BY 1, 2 ORDER BY 1 DESC, 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
