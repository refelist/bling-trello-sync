    {
      "type": "barchart",
      "title": "Em aberto por mês de vencimento",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financeiro"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(date_trunc('month', vencimento), 'MM/YY') AS \"Mês\", SUM(valor_em_aberto) AS \"Em aberto\" FROM vw_contas_em_aberto WHERE natureza = 'receita' AND empresa IN ($empresa) AND vencimento IS NOT NULL GROUP BY date_trunc('month', vencimento) ORDER BY date_trunc('month', vencimento)"
        }
      ],
