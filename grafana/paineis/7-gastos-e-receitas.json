          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT categoria AS \"Categoria\", -SUM(valor) AS \"Despesas\" FROM vw_dre WHERE natureza = 'despesa' AND empresa IN ($empresa) AND $__timeFilter(competencia) GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
