# Aplicativo criado em Bling > Central de Extensões > Área do Integrador
BLING_CLIENT_ID=seu_client_id
BLING_CLIENT_SECRET=seu_client_secret
# Mesma URL cadastrada como "link de redirecionamento" no aplicativo do Bling.
BLING_REDIRECT_URI=http://localhost:8000/callback

# Trello: chave em https://trello.com/power-ups/admin e token gerado com essa chave
TRELLO_API_KEY=sua_api_key
TRELLO_TOKEN=seu_token
TRELLO_BOARD_ID=id_do_board
TRELLO_LIST_ID_PADRAO=id_da_lista_de_entrada

# Opcional: mapa "id da situação do Bling" -> "id da lista do Trello".
# A chave é o id da situação (veja `situacoes-pedidos`) ou o nome dela; o valor é o id da lista
# (veja `listas-trello`) ou o nome da lista. Vazio manda tudo para a lista padrão.
# Exemplo: {"6":"PEDIDO EM ABERTO","9":"EM TRANSITO","12":"CANCELADOS"}
TRELLO_LIST_ID_POR_SITUACAO=

# Opcional: nomes das situações do Bling, usados quando o app não tem acesso ao módulo Situações.
# Exemplo: {"9":"Em aberto","12":"Atendido"}
NOMES_SITUACOES=

# Opcional: não sincronizar pedidos destas lojas (ids separados por vírgula; veja `lojas-bling`).
LOJAS_IGNORADAS=
# Opcional: sincronizar somente estas lojas (tem prioridade sobre LOJAS_IGNORADAS).
LOJAS_PERMITIDAS=

# Pedidos de compra (quadro separado). O Bling não tem webhook de compra, então o
# programa consulta a API de tempos em tempos enquanto o serviço estiver no ar.
COMPRAS_ATIVO=false
TRELLO_BOARD_ID_COMPRAS=
TRELLO_LIST_ID_PADRAO_COMPRAS=EM ABERTO
# Chave: valor da situação da compra (0 Em aberto, 1 Atendido, 2 Cancelado, 3 Em andamento).
TRELLO_LIST_ID_POR_SITUACAO_COMPRA={"0":"EM ABERTO","3":"EM ANDAMENTO","1":"ATENDIDOS","2":"CANCELADOS"}
# Período consultado a cada varredura e intervalo entre elas.
COMPRAS_DIAS=30
COMPRAS_INTERVALO_MINUTOS=5

# Opcional: etiquetas aplicadas em todo card criado
TRELLO_LABEL_IDS=

DATABASE_PATH=bling_trello_sync.db

# Modo servidor (webhook): desative apenas para testes locais sem assinatura do Bling.
VERIFICAR_ASSINATURA_WEBHOOK=true
