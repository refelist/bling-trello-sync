# =============================================================================
# Conta 1 — JH Shopping LTDA
# Copie para .env:  cp .env.example .env
# Preencha só os campos marcados com <...> (segredos). O restante já reflete
# a configuração operacional em uso no servidor.
# Segunda conta Bling (JHS Shopping LTDA): veja .env.example.segunda-empresa
# =============================================================================

# Aplicativo Bling (Central de Extensões → Área do Integrador)
BLING_CLIENT_ID=<client_id_bling_jh>
BLING_CLIENT_SECRET=<client_secret_bling_jh>
# Mesma URL cadastrada como link de redirecionamento no app do Bling.
BLING_REDIRECT_URI=https://refelist-bling.duckdns.org/oauth/bling/callback
VERIFICAR_ASSINATURA_WEBHOOK=true

# Trello — vendas
TRELLO_API_KEY=<trello_api_key>
TRELLO_TOKEN=<trello_token>
TRELLO_BOARD_ID=6784fe053dc37f16eb7a1307
TRELLO_LIST_ID_PADRAO=6784fe064c9a45311aa5f0ab
TRELLO_LIST_ID_POR_SITUACAO={"6":"PEDIDO EM ABERTO","21":"PEDIDO EM ABERTO","9":"EM TRANSITO","37589":"FATURADOS PARCIALMENTE","12":"CANCELADOS"}
TRELLO_LABEL_IDS=

NOMES_SITUACOES={"6":"Em aberto","21":"Em digitação","9":"Atendido","37589":"Faturado parcialmente","12":"Cancelado"}

LOJAS_IGNORADAS=205391030
LOJAS_PERMITIDAS=

# SQLite operacional desta cópia (tokens Bling + vínculo pedido→card)
DATABASE_PATH=bling_trello_sync.db

# Pedidos de compra (quadro separado; sem webhook no Bling)
COMPRAS_ATIVO=true
TRELLO_BOARD_ID_COMPRAS=cxZwz0gK
TRELLO_LIST_ID_PADRAO_COMPRAS=EM ABERTO
TRELLO_LIST_ID_POR_SITUACAO_COMPRA={"0":"EM ABERTO","3":"EM ANDAMENTO","1":"ATENDIDOS","2":"CANCELADOS"}
COMPRAS_DIAS=30
COMPRAS_INTERVALO_MINUTOS=5

# Financeiro — mesma base Postgres das duas contas; coluna empresa separa os dados
FINANCEIRO_ATIVO=true
FINANCEIRO_EMPRESA=JH Shopping LTDA
FINANCEIRO_DATABASE_URL=postgresql://bling_app:<senha_postgres>@localhost:5432/financeiro
FINANCEIRO_DIAS=365
FINANCEIRO_DIAS_FUTUROS=365
FINANCEIRO_INTERVALO_MINUTOS=60

# Rotas admin (/sincronizar, /trello/listas, POST /oauth/bling/ticket)
# Só Authorization: Bearer … ou X-API-Key (nunca na query string).
# Para autorizar no navegador: POST /oauth/bling/ticket e abra o campo "autorizar".
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=<api_token_longo>
