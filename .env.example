# Aplicativo criado em Bling > Central de Extensões > Área do Integrador
BLING_CLIENT_ID=seu_client_id
BLING_CLIENT_SECRET=seu_client_secret
# Mesma URL cadastrada como "link de redirecionamento" no aplicativo do Bling.
# Local: http://localhost:8000/callback  |  Servidor: https://seu-dominio/oauth/bling/callback
BLING_REDIRECT_URI=https://seu-dominio/oauth/bling/callback
# Desative apenas para testes locais sem assinatura do Bling.
VERIFICAR_ASSINATURA_WEBHOOK=true

# Trello: chave em https://trello.com/power-ups/admin e token gerado com essa chave
TRELLO_API_KEY=sua_api_key
TRELLO_TOKEN=seu_token
TRELLO_BOARD_ID=id_do_board
TRELLO_LIST_ID_PADRAO=id_da_lista_de_entrada

# Mapa "id ou nome da situação do Bling" -> "id ou nome da lista do Trello".
# Veja `situacoes-pedidos` e `listas-trello`. Vazio manda tudo para a lista padrão.
# Exemplo: {"6":"PEDIDO EM ABERTO","21":"PEDIDO EM ABERTO","9":"EM TRANSITO","12":"CANCELADOS"}
TRELLO_LIST_ID_POR_SITUACAO=

# Opcional: etiquetas aplicadas em todo card criado
TRELLO_LABEL_IDS=

# Nomes das situações quando o app não tem o escopo Situações no Bling.
# Exemplo: {"6":"Em aberto","9":"Atendido","12":"Cancelado"}
NOMES_SITUACOES=

# Não sincronizar pedidos destas lojas (ids separados por vírgula; veja `lojas-bling`).
LOJAS_IGNORADAS=
# Sincronizar somente estas lojas (tem prioridade sobre LOJAS_IGNORADAS).
LOJAS_PERMITIDAS=

DATABASE_PATH=bling_trello_sync.db

# Pedidos de compra (quadro separado). Sem webhook no Bling: varredura periódica.
COMPRAS_ATIVO=false
TRELLO_BOARD_ID_COMPRAS=
TRELLO_LIST_ID_PADRAO_COMPRAS=EM ABERTO
# 0 Em aberto, 1 Atendido, 2 Cancelado, 3 Em andamento
TRELLO_LIST_ID_POR_SITUACAO_COMPRA={"0":"EM ABERTO","3":"EM ANDAMENTO","1":"ATENDIDOS","2":"CANCELADOS"}
COMPRAS_DIAS=30
COMPRAS_INTERVALO_MINUTOS=5

# Financeiro (Power BI / Grafana). Independente do Trello.
FINANCEIRO_ATIVO=false
# Nome desta conta Bling na coluna empresa dos relatórios.
FINANCEIRO_EMPRESA=Empresa 1
# PostgreSQL (produção) ou caminho SQLite (local/testes).
# Exemplo: postgresql://usuario:senha@localhost:5432/financeiro
FINANCEIRO_DATABASE_URL=financeiro.db
FINANCEIRO_DIAS=365
FINANCEIRO_DIAS_FUTUROS=365
FINANCEIRO_INTERVALO_MINUTOS=60

# Obrigatório no modo servidor para /sincronizar, /trello/listas e /oauth/bling/autorizar.
# Envie em Authorization: Bearer <token>, X-API-Key ou ?token= na URL.
# O webhook do Bling não usa este token (só a assinatura HMAC).
# Gere um valor longo, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=
