/// Pedidos de venda do Bling, usados como base do faturamento (visão vw_faturamento).
table Faturamento

	/// Valor total dos pedidos de venda no período.
	measure Faturamento = SUM(Faturamento[Total do Pedido])
		formatString: \R$ #,##0.00
		displayFolder: Vendas

	/// Quantidade de pedidos de venda no período.
	measure 'Qtde de Pedidos' = COUNTROWS(Faturamento)
		formatString: #,##0
		displayFolder: Vendas

	/// Faturamento dividido pela quantidade de pedidos.
	measure 'Ticket Médio' = DIVIDE([Faturamento], [Qtde de Pedidos])
		formatString: \R$ #,##0.00
		displayFolder: Vendas

	/// Faturamento do início do ano até hoje, ou até o fim do período selecionado se ele terminar antes.
	measure 'Faturamento YTD' = ```
			VAR Referencia = MIN(MAX('Calendário'[Data]), TODAY())
			RETURN
			    IF(
			        YEAR(Referencia) >= YEAR(MIN('Calendário'[Data])),
			        CALCULATE([Faturamento], DATESBETWEEN('Calendário'[Data], DATE(YEAR(Referencia), 1, 1), Referencia))
			    )
			```
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Mesmo acumulado do ano anterior; vazio se os dados não cobrem o ano anterior inteiro.
	measure 'Faturamento YTD AA' = ```
			VAR Referencia = MIN(MAX('Calendário'[Data]), TODAY())
			VAR Inicio = DATE(YEAR(Referencia) - 1, 1, 1)
			VAR PrimeiraData = CALCULATE(MIN(Faturamento[Data]), REMOVEFILTERS('Calendário'))
			RETURN
			    IF(
			        YEAR(Referencia) >= YEAR(MIN('Calendário'[Data])) && PrimeiraData <= Inicio,
			        CALCULATE([Faturamento], DATESBETWEEN('Calendário'[Data], Inicio, EDATE(Referencia, -12)))
			    )
			```
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Faturamento no mesmo período do ano anterior.
	measure 'Faturamento AA' = CALCULATE([Faturamento], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Variação do faturamento acumulado no ano contra o mesmo acumulado do ano anterior.
	measure 'Faturamento vs AA %' = DIVIDE([Faturamento YTD] - [Faturamento YTD AA], [Faturamento YTD AA])
		formatString: 0.0%
		displayFolder: Comparativos

	/// Frase-resumo do slide Faturamento.
	measure 'Manchete Faturamento' = ```
			VAR Fat = COALESCE([Faturamento], 0)
			VAR Ticket = COALESCE([Ticket Médio], 0)
			RETURN
			    IF(ABS(Fat) >= 1000000, FORMAT(Fat / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Fat) >= 1000, FORMAT(Fat / 1000, "\R$ #,##0.0") & " mil", FORMAT(Fat, "\R$ #,##0"))) & " faturados em " & FORMAT(COALESCE([Qtde de Pedidos], 0), "#,##0")
			        & " pedidos, com ticket médio de " & IF(ABS(Ticket) >= 1000000, FORMAT(Ticket / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Ticket) >= 1000, FORMAT(Ticket / 1000, "\R$ #,##0.0") & " mil", FORMAT(Ticket, "\R$ #,##0")))
			```
		displayFolder: Textos

	column Empresa
		dataType: string
		sourceColumn: empresa

	column Data
		dataType: dateTime
		formatString: Short Date
		sourceColumn: data

	column 'Número do Pedido'
		dataType: string
		summarizeBy: none
		sourceColumn: numero

	column Cliente
		dataType: string
		sourceColumn: contato_nome

	column 'Loja Id'
		dataType: int64
		summarizeBy: none
		sourceColumn: loja_id

	column 'Situação Id'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: situacao_id

	column 'Total do Pedido'
		dataType: decimal
		isHidden
		formatString: \R$ #,##0.00
		sourceColumn: total

	partition Faturamento = m
		mode: import
		source = ```
				let
				    // Pedidos de venda com valor total, cliente e loja de origem.
				    Fonte = PostgreSQL.Database(#"Servidor", #"Banco"),
				    #"Selecionada a visão de faturamento" = Fonte{[Schema="public", Item="vw_faturamento"]}[Data]
				in
				    #"Selecionada a visão de faturamento"
				```
