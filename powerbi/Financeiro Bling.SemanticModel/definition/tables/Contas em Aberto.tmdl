/// Saldo ainda não liquidado das contas a pagar e a receber, por vencimento (visão vw_contas_em_aberto).
table 'Contas em Aberto'

	/// Saldo de contas a receber ainda em aberto.
	measure 'A Receber em Aberto' = CALCULATE(SUM('Contas em Aberto'[Valor em Aberto]), 'Contas em Aberto'[Natureza] = "receita")
		formatString: \R$ #,##0.00
		displayFolder: Em aberto

	/// Saldo de contas a pagar ainda em aberto.
	measure 'A Pagar em Aberto' = CALCULATE(SUM('Contas em Aberto'[Valor em Aberto]), 'Contas em Aberto'[Natureza] = "despesa")
		formatString: \R$ #,##0.00
		displayFolder: Em aberto

	/// Diferença entre o que há para receber e o que há para pagar.
	measure 'Saldo Previsto' = [A Receber em Aberto] - [A Pagar em Aberto]
		formatString: \R$ #,##0.00
		displayFolder: Em aberto

	/// Contas a receber com vencimento anterior a hoje.
	measure 'Receber Vencido' = CALCULATE([A Receber em Aberto], FILTER(ALL('Calendário'), 'Calendário'[Data] < TODAY()))
		formatString: \R$ #,##0.00
		displayFolder: Prazos

	/// Contas a pagar com vencimento anterior a hoje.
	measure 'Pagar Vencido' = CALCULATE([A Pagar em Aberto], FILTER(ALL('Calendário'), 'Calendário'[Data] < TODAY()))
		formatString: \R$ #,##0.00
		displayFolder: Prazos

	/// Contas a receber que vencem de hoje até 30 dias.
	measure 'Receber 30 dias' = ```
			CALCULATE(
			    [A Receber em Aberto],
			    FILTER(ALL('Calendário'), 'Calendário'[Data] >= TODAY() && 'Calendário'[Data] <= TODAY() + 30)
			)
			```
		formatString: \R$ #,##0.00
		displayFolder: Prazos

	/// Contas a pagar que vencem de hoje até 30 dias.
	measure 'Pagar 30 dias' = ```
			CALCULATE(
			    [A Pagar em Aberto],
			    FILTER(ALL('Calendário'), 'Calendário'[Data] >= TODAY() && 'Calendário'[Data] <= TODAY() + 30)
			)
			```
		formatString: \R$ #,##0.00
		displayFolder: Prazos

	/// Frase-resumo do slide Contas a Pagar.
	measure 'Manchete Pagar' = ```
			VAR Aberto = COALESCE([A Pagar em Aberto], 0)
			VAR Vencido = COALESCE([Pagar Vencido], 0)
			VAR Proximos = COALESCE([Pagar 30 dias], 0)
			RETURN
			    IF(ABS(Aberto) >= 1000000, FORMAT(Aberto / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Aberto) >= 1000, FORMAT(Aberto / 1000, "\R$ #,##0.0") & " mil", FORMAT(Aberto, "\R$ #,##0"))) & " a pagar em aberto: " & IF(ABS(Vencido) >= 1000000, FORMAT(Vencido / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Vencido) >= 1000, FORMAT(Vencido / 1000, "\R$ #,##0.0") & " mil", FORMAT(Vencido, "\R$ #,##0")))
			        & " já vencidos e " & IF(ABS(Proximos) >= 1000000, FORMAT(Proximos / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Proximos) >= 1000, FORMAT(Proximos / 1000, "\R$ #,##0.0") & " mil", FORMAT(Proximos, "\R$ #,##0"))) & " vencendo nos próximos 30 dias"
			```
		displayFolder: Textos

	/// Frase-resumo do slide Contas a Receber.
	measure 'Manchete Receber' = ```
			VAR Aberto = COALESCE([A Receber em Aberto], 0)
			VAR Vencido = COALESCE([Receber Vencido], 0)
			VAR Proximos = COALESCE([Receber 30 dias], 0)
			RETURN
			    IF(ABS(Aberto) >= 1000000, FORMAT(Aberto / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Aberto) >= 1000, FORMAT(Aberto / 1000, "\R$ #,##0.0") & " mil", FORMAT(Aberto, "\R$ #,##0"))) & " a receber em aberto: " & IF(ABS(Vencido) >= 1000000, FORMAT(Vencido / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Vencido) >= 1000, FORMAT(Vencido / 1000, "\R$ #,##0.0") & " mil", FORMAT(Vencido, "\R$ #,##0")))
			        & " já vencidos e " & IF(ABS(Proximos) >= 1000000, FORMAT(Proximos / 1000000, "\R$ #,##0.00") & " Mi", IF(ABS(Proximos) >= 1000, FORMAT(Proximos / 1000, "\R$ #,##0.0") & " mil", FORMAT(Proximos, "\R$ #,##0"))) & " vencendo nos próximos 30 dias"
			```
		displayFolder: Textos

	column Empresa
		dataType: string
		sourceColumn: empresa

	/// receita (a receber) ou despesa (a pagar).
	column Natureza
		dataType: string
		sourceColumn: natureza

	column Vencimento
		dataType: dateTime
		formatString: Short Date
		sourceColumn: vencimento

	column Categoria
		dataType: string
		sourceColumn: categoria

	column Contato
		dataType: string
		sourceColumn: contato_nome

	column 'Valor em Aberto'
		dataType: decimal
		isHidden
		formatString: \R$ #,##0.00
		sourceColumn: valor_em_aberto

	partition 'Contas em Aberto' = m
		mode: import
		source = ```
				let
				    // Títulos que ainda têm saldo a liquidar, com o vencimento de cada um.
				    Fonte = PostgreSQL.Database(#"Servidor", #"Banco"),
				    #"Selecionada a visão de contas em aberto" = Fonte{[Schema="public", Item="vw_contas_em_aberto"]}[Data]
				in
				    #"Selecionada a visão de contas em aberto"
				```
