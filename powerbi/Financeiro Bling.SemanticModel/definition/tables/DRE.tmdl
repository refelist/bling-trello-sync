/// Receitas e despesas por categoria e competência (visão vw_dre). Receita entra positiva e despesa negativa.
table DRE

	/// Total das receitas lançadas na competência.
	measure 'Receita Bruta' = CALCULATE(SUM(DRE[Valor com Sinal]), DRE[Natureza] = "receita")
		formatString: \R$ #,##0.00
		displayFolder: DRE

	/// Total das despesas lançadas na competência, em valor positivo.
	measure Despesas = -CALCULATE(SUM(DRE[Valor com Sinal]), DRE[Natureza] = "despesa")
		formatString: \R$ #,##0.00
		displayFolder: DRE

	/// Receita bruta menos despesas do período.
	measure Resultado = SUM(DRE[Valor com Sinal])
		formatString: \R$ #,##0.00
		displayFolder: DRE

	/// Resultado dividido pela receita bruta.
	measure 'Margem %' = DIVIDE([Resultado], [Receita Bruta])
		formatString: 0.0%
		displayFolder: DRE

	/// Resultado do início do ano até hoje, ou até o fim do período selecionado se ele terminar antes.
	measure 'Resultado YTD' = ```
			VAR Referencia = MIN(MAX('Calendário'[Data]), TODAY())
			RETURN
			    IF(
			        YEAR(Referencia) >= YEAR(MIN('Calendário'[Data])),
			        CALCULATE([Resultado], DATESBETWEEN('Calendário'[Data], DATE(YEAR(Referencia), 1, 1), Referencia))
			    )
			```
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Receita bruta do início do ano até hoje, ou até o fim do período selecionado se ele terminar antes.
	measure 'Receita Bruta YTD' = ```
			VAR Referencia = MIN(MAX('Calendário'[Data]), TODAY())
			RETURN
			    IF(
			        YEAR(Referencia) >= YEAR(MIN('Calendário'[Data])),
			        CALCULATE([Receita Bruta], DATESBETWEEN('Calendário'[Data], DATE(YEAR(Referencia), 1, 1), Referencia))
			    )
			```
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Mesmo acumulado do ano anterior; vazio se os dados não cobrem o ano anterior inteiro.
	measure 'Receita Bruta YTD AA' = ```
			VAR Referencia = MIN(MAX('Calendário'[Data]), TODAY())
			VAR Inicio = DATE(YEAR(Referencia) - 1, 1, 1)
			VAR PrimeiraData = CALCULATE(MIN(DRE[Competência]), REMOVEFILTERS('Calendário'))
			RETURN
			    IF(
			        YEAR(Referencia) >= YEAR(MIN('Calendário'[Data])) && PrimeiraData <= Inicio,
			        CALCULATE([Receita Bruta], DATESBETWEEN('Calendário'[Data], Inicio, EDATE(Referencia, -12)))
			    )
			```
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Receita bruta no mesmo período do ano anterior.
	measure 'Receita Bruta AA' = CALCULATE([Receita Bruta], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Despesas no mesmo período do ano anterior.
	measure 'Despesas AA' = CALCULATE([Despesas], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: \R$ #,##0.00
		displayFolder: Comparativos

	/// Variação da receita bruta acumulada no ano contra o mesmo acumulado do ano anterior.
	measure 'Receita vs AA %' = DIVIDE([Receita Bruta YTD] - [Receita Bruta YTD AA], [Receita Bruta YTD AA])
		formatString: 0.0%
		displayFolder: Comparativos

	column Empresa
		dataType: string
		sourceColumn: empresa

	column Competência
		dataType: dateTime
		formatString: Short Date
		sourceColumn: competencia

	/// receita ou despesa.
	column Natureza
		dataType: string
		sourceColumn: natureza

	/// Categoria de receita ou despesa cadastrada no Bling.
	column Categoria
		dataType: string
		sourceColumn: categoria

	/// Valor positivo nas receitas e negativo nas despesas.
	column 'Valor com Sinal'
		dataType: decimal
		isHidden
		formatString: \R$ #,##0.00
		sourceColumn: valor

	partition DRE = m
		mode: import
		source = ```
				let
				    // Lançamentos por categoria e competência, já com sinal de receita ou despesa.
				    Fonte = PostgreSQL.Database(#"Servidor", #"Banco"),
				    #"Selecionada a visão de DRE" = Fonte{[Schema="public", Item="vw_dre"]}[Data]
				in
				    #"Selecionada a visão de DRE"
				```
